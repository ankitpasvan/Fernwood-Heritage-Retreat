@model IEnumerable<HotelBookingSystem.Models.Room>
@{
    ViewData["Title"] = "Rooms";
}
<div class="container py-5" style="margin-top: 70px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="font-family: 'Playfair Display', serif;">Rooms</h2>
        <a asp-action="Create" class="btn btn-heritage">Add Room</a>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Room No.</th>
                <th>Room Type</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RoomNumber</td>
                    <td>@item.RoomType?.Name</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.RoomId">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.RoomId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
