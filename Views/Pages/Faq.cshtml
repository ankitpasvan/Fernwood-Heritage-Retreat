@{
    ViewData["Title"] = "FAQs - Fernwood Heritage Retreat";
}

<!-- PAGE BANNER -->
<section class="page-banner">
    <img class="page-banner-img" src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1920&q=80"
         alt="Fernwood Heritage Retreat exterior" />
    <div class="page-banner-overlay"></div>
    <div class="container page-banner-content">
        <h1 class="page-banner-title">Frequently Asked Questions</h1>
        <p class="page-breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> &raquo; FAQs</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <p class="text-muted text-center mb-4">Answers to the questions guests ask us most often.</p>
                <div class="accordion faq-accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading1">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1">
                                What are the check-in and check-out times?
                            </button>
                        </h2>
                        <div id="faqCollapse1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Check-in is from 2:00 PM and check-out is until 11:00 AM.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading2">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">
                                How do I book a room?
                            </button>
                        </h2>
                        <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Log in or create an account, search by check-in date, check-out date and guests, choose
                                a room, confirm the booking, then pay with mock Card or UPI. You get a confirmation with
                                a Booking ID.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading3">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">
                                How long is my booking held while I pay?
                            </button>
                        </h2>
                        <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Your booking stays Pending for 15 minutes while you pay. If the hold expires without a
                                successful payment, the booking is cancelled and the room becomes free again.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading4">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4">
                                What happens if my payment fails?
                            </button>
                        </h2>
                        <div id="faqCollapse4" class="accordion-collapse collapse" aria-labelledby="faqHeading4"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                The booking stays Pending, so you can retry the payment within the 15-minute hold.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading5">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse5" aria-expanded="false" aria-controls="faqCollapse5">
                                Can I cancel my booking?
                            </button>
                        </h2>
                        <div id="faqCollapse5" class="accordion-collapse collapse" aria-labelledby="faqHeading5"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. Open My Bookings and cancel a Pending or Confirmed booking before its check-in
                                date.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading6">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse6" aria-expanded="false" aria-controls="faqCollapse6">
                                Do I need an account to make a booking?
                            </button>
                        </h2>
                        <div id="faqCollapse6" class="accordion-collapse collapse" aria-labelledby="faqHeading6"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. Bookings are linked to your account, so you can see them in My Bookings and manage
                                them later.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading7">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse7" aria-expanded="false" aria-controls="faqCollapse7">
                                Is parking available?
                            </button>
                        </h2>
                        <div id="faqCollapse7" class="accordion-collapse collapse" aria-labelledby="faqHeading7"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes, free parking is available at the hotel.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading8">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faqCollapse8" aria-expanded="false" aria-controls="faqCollapse8">
                                How can I contact the hotel?
                            </button>
                        </h2>
                        <div id="faqCollapse8" class="accordion-collapse collapse" aria-labelledby="faqHeading8"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Use the Contact page form, or call +91 98765 43210, or email stay@fernwoodheritage.in.
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-center mt-4">Still have a question? <a asp-controller="Pages" asp-action="Contact">Send
                    us a message</a>.</p>
                </div>
            </div>
        </div>
    </section>
