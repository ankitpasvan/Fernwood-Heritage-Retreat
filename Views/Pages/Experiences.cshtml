@{
    ViewData["Title"] = "Experiences - Fernwood Heritage Retreat";
}

<!-- PAGE BANNER -->
<section class="page-banner">
    <img class="page-banner-img" src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80"
         alt="Mountain valley near Fernwood" />
    <div class="page-banner-overlay"></div>
    <div class="container page-banner-content">
        <h1 class="page-banner-title">Experiences</h1>
        <p class="page-breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> &raquo; Experiences</p>
    </div>
</section>

<!-- EXPERIENCES -->
<section class="section fade-in">
    <div class="container">
        <p class="text-muted text-center mb-4">Fernwood is not about rushing from one sight to another. It is about slow
            mornings, quiet walks and evenings by the fire.</p>
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="exp-tall">
                        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&q=80"
                             alt="Bonfire evenings at Fernwood" />
                        <div class="exp-tall-body">
                            <p class="exp-tall-eyebrow">Evenings</p>
                            <h3>Bonfire Evenings</h3>
                            <p>Evening bonfire with valley lights below, on request and weather permitting.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 mb-4">
                    <div class="exp-tall">
                        <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&q=80"
                             alt="Valley view near Fernwood" />
                        <div class="exp-tall-body">
                            <p class="exp-tall-eyebrow">Mornings</p>
                            <h3>Nature Walk</h3>
                            <p>Guided morning walk to the waterfall and nearby trails through oak and deodar.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 mb-4">
                    <div class="exp-tall">
                        <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1200&q=80"
                             alt="Dining at Fernwood" />
                        <div class="exp-tall-body">
                            <p class="exp-tall-eyebrow">Mornings</p>
                            <h3>Yoga &amp; Terrace Breakfast</h3>
                            <p>Start the day with gentle yoga and breakfast on the terrace.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 mb-4">
                    <div class="exp-tall">
                        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?w=1200&q=80"
                             alt="Deluxe room at Fernwood" />
                        <div class="exp-tall-body">
                            <p class="exp-tall-eyebrow">Afternoons</p>
                            <h3>Library &amp; Indoor Games</h3>
                            <p>Cozy sit-outs, books, board games and quiet corners for slow afternoons.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-8 mx-auto text-center">
                    <p class="text-muted">To add an experience to your stay, mention it while booking or ask at reception.
                        The bonfire is arranged at an additional charge, subject to weather conditions.</p>
                        <a class="btn btn-heritage btn-lg" asp-controller="Rooms" asp-action="Search">Check Availability</a>
                    </div>
                </div>
            </div>
        </section>
