@{
    ViewData["Title"] = "Experiences - Fernwood Heritage Retreat";
}

<!-- PAGE BANNER -->
<section class="page-banner">
    <img class="page-banner-img" src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80"
         alt="Mountain valley near Fernwood" />
    <div class="page-banner-overlay"></div>
    <div class="container page-banner-content">
        <h1 class="page-banner-title">Experiences</h1>
        <p class="page-breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> &raquo; Experiences</p>
    </div>
</section>

<!-- EXPERIENCES -->
<section class="section fade-in">
    <div class="container">
        <p class="text-muted text-center mb-4">Fernwood is not about rushing from one sight to another. It is about slow
            mornings, quiet walks and evenings by the fire.</p>
            <div class="row">
                <div class="col-md-3 mb-4">
                    <div class="card exp-card h-100">
                        <div class="card-body">
                            <h5>Bonfire Evenings</h5>
                            <p class="text-muted">Evening bonfire with valley lights below, on request and weather
                                permitting.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card exp-card h-100">
                            <div class="card-body">
                                <h5>Nature Walk</h5>
                                <p class="text-muted">Guided morning walk to the waterfall and nearby trails through oak and
                                    deodar.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-4">
                            <div class="card exp-card h-100">
                                <div class="card-body">
                                    <h5>Yoga &amp; Terrace Breakfast</h5>
                                    <p class="text-muted">Start the day with gentle yoga and breakfast on the terrace.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-4">
                            <div class="card exp-card h-100">
                                <div class="card-body">
                                    <h5>Library &amp; Indoor Games</h5>
                                    <p class="text-muted">Cozy sit-outs, books, board games and quiet corners for slow afternoons.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mx-auto text-center">
                            <p class="text-muted">To add an experience to your stay, mention it while booking or ask at reception.
                                The bonfire is arranged at an additional charge, subject to weather conditions.</p>
                                <a class="btn btn-heritage btn-lg" asp-controller="Rooms" asp-action="Search">Check Availability</a>
                            </div>
                        </div>
                    </div>
                </section>
