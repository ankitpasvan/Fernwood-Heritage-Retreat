@{
    ViewData["Title"] = "Gallery - Fernwood Heritage Retreat";
}

<!-- PAGE BANNER -->
<section class="page-banner">
    <img class="page-banner-img" src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=1920&q=80"
         alt="Suite at Fernwood" />
    <div class="page-banner-overlay"></div>
    <div class="container page-banner-content">
        <h1 class="page-banner-title">Gallery</h1>
        <p class="page-breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> &raquo; Gallery</p>
    </div>
</section>

<!-- GALLERY GRID -->
<section class="section fade-in">
    <div class="container">
        <p class="text-muted text-center mb-4">Rooms, dining, valley views and quiet corners - a small look at the place
            before you arrive.</p>
            <div class="row g-3">
                <div class="col-md-4"><img class="img-fluid rounded gallery-img"
                                               src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80"
                                               alt="Hotel exterior" /></div>
                    <div class="col-md-4"><img class="img-fluid rounded gallery-img"
                                                   src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?w=800&q=80" alt="Room" /></div>
                        <div class="col-md-4"><img class="img-fluid rounded gallery-img"
                                                       src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&q=80" alt="Dining" /></div>
                            <div class="col-md-4"><img class="img-fluid rounded gallery-img"
                                                           src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80" alt="Valley view" />
                            </div>
                            <div class="col-md-4"><img class="img-fluid rounded gallery-img"
                                                           src="https://images.unsplash.com/photo-1582719508461-905c673771fd?w=800&q=80" alt="Deluxe room" />
                            </div>
                            <div class="col-md-4"><img class="img-fluid rounded gallery-img"
                                                           src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=800&q=80" alt="Suite" /></div>
                            </div>
                            <div class="text-center mt-4">
                                <a class="btn btn-heritage btn-lg" asp-controller="Rooms" asp-action="Index">View Rooms</a>
                            </div>
                        </div>
                    </section>
