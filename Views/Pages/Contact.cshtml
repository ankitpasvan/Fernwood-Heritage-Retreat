@model HotelBookingSystem.Models.ContactEnquiry
@{
    ViewData["Title"] = "Contact - Fernwood Heritage Retreat";
}

<!-- PAGE BANNER -->
<section class="page-banner">
    <img class="page-banner-img" src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1920&q=80"
         alt="Fernwood Heritage Retreat exterior" />
    <div class="page-banner-overlay"></div>
    <div class="container page-banner-content">
        <h1 class="page-banner-title">Contact Us</h1>
        <p class="page-breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> &raquo; Contact Us</p>
    </div>
</section>

<!-- CONTACT INFO + FORM -->
<section class="section fade-in">
    <div class="container">
        <p class="text-muted text-center mb-5">Questions about rooms, dates, food or experiences - send us a message and
            we will get back to you soon.</p>
            <div class="row">
                <div class="col-md-5 mb-4">
                    <h2 class="contact-heading">Contact Information</h2>
                    <h5 class="contact-label">Phone Number</h5>
                    <p>+91 98765 43210</p>
                    <h5 class="contact-label">Email Id</h5>
                    <p>stay@fernwoodheritage.in</p>
                    <h5 class="contact-label">Address</h5>
                    <p>Fernwood Estate, Jharipani Road, Mussoorie Hills,<br />Mussoorie, Uttarakhand</p>
                    <p class="mb-1"><strong>Check-in:</strong> 2:00 PM</p>
                    <p class="mb-1"><strong>Check-out:</strong> 11:00 AM</p>
                    <p class="mb-1"><strong>Reception:</strong> 8:00 AM - 9:00 PM</p>
                    <p class="text-muted small mt-3">For bookings, use the Check Availability button - it searches live room
                        availability from the database.</p>
                        <a class="btn btn-heritage mt-2" asp-controller="Rooms" asp-action="Search">Check Availability</a>
                    </div>
                    <div class="col-md-7">
                        <div class="card shadow">
                            <div class="card-body p-4">
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                                }
                                <h5 class="card-title mb-3">Send an enquiry</h5>
                                <form asp-controller="Pages" asp-action="Contact" method="post">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" asp-for="Name">Enter Name</label>
                                            <input class="form-control" asp-for="Name" />
                                            <span class="text-danger" asp-validation-for="Name"></span>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" asp-for="Email">Enter Email</label>
                                            <input class="form-control" asp-for="Email" />
                                            <span class="text-danger" asp-validation-for="Email"></span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" asp-for="Phone">Enter Phone Number</label>
                                            <input class="form-control" asp-for="Phone" />
                                            <span class="text-danger" asp-validation-for="Phone"></span>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" asp-for="City">Enter City</label>
                                            <input class="form-control" asp-for="City" />
                                            <span class="text-danger" asp-validation-for="City"></span>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" asp-for="Message">Write Message to us!</label>
                                        <textarea class="form-control" asp-for="Message" rows="4"></textarea>
                                        <span class="text-danger" asp-validation-for="Message"></span>
                                    </div>
                                    <button class="btn btn-heritage w-100" type="submit">SEND</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
