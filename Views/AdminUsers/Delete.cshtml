@model HotelBookingSystem.Models.User
@{
    ViewData["Title"] = "Delete User";
}
<div class="container py-5" style="margin-top: 70px;">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <h2 style="font-family: 'Playfair Display', serif;">Delete User</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <p>Are you sure you want to delete this user?</p>
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>
                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@Model.Role</dd>
                <dt class="col-sm-3">Joined</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Bookings</dt>
                <dd class="col-sm-9">@ViewBag.BookingCount</dd>
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="UserId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-secondary">Back to Customers</a>
            </form>
        </div>
    </div>
</div>
