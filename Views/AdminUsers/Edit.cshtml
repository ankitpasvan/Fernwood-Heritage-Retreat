@model HotelBookingSystem.Models.User
@{
    ViewData["Title"] = "Edit User";
}
<div class="container py-5" style="margin-top: 70px;">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <h2 style="font-family: 'Playfair Display', serif;">Edit User</h2>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label class="form-label">Email (cannot be changed)</label>
                    <input class="form-control" value="@Model.Email" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="Customer">Customer</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-heritage">Save Changes</button>
                <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-secondary">Back to Customers</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
