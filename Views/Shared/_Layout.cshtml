<ul class="navbar-nav ms-auto align-items-lg-center">
    <li class="nav-item"><a class="nav-link" href="/#home">Home</a></li>
    <li class="nav-item"><a class="nav-link" href="/#rooms">Rooms</a></li>
    <li class="nav-item"><a class="nav-link" href="/#dining">Dining</a></li>
    <li class="nav-item"><a class="nav-link" href="/#experiences">Experiences</a></li>
    <li class="nav-item"><a class="nav-link" href="/#gallery">Gallery</a></li>
    <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
    <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
    <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
    <li class="nav-item ms-lg-3 mt-2 mt-lg-0"><a class="btn btn-heritage" href="/#booking">Book Now</a></li>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
            <span class="nav-link">Hello, @User.Identity.Name</span>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item mt-2 mt-lg-0"><a class="nav-link" asp-controller="AdminRoomTypes" asp-action="Index">Room
                Types</a></li>
                <li class="nav-item mt-2 mt-lg-0"><a class="nav-link" asp-controller="AdminRooms" asp-action="Index">Rooms</a></li>
            }
            <li class="nav-item mt-2 mt-lg-0">
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                </form>
            </li>
        }

        else
        {
            <li class="nav-item ms-lg-2 mt-2 mt-lg-0"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
            </li>
            <li class="nav-item mt-2 mt-lg-0"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
            </li>
        }
    </ul>
