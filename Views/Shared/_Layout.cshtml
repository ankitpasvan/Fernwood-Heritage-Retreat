<!DOCTYPE html>
<html lang="en">

@{
    var navController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var navAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string, bool> isCurrent = (controller, action) =>
        string.Equals(navController, controller, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(action) || string.Equals(navAction, action, StringComparison.OrdinalIgnoreCase));
    bool homeActive = isCurrent("Home", "Index");
    bool hotelActive = isCurrent("Rooms", "") || isCurrent("Reviews", "Index") || isCurrent("Pages", "About") ||
isCurrent("Pages", "Faq");
    bool diningActive = isCurrent("Pages", "Dining");
    bool experiencesActive = isCurrent("Pages", "Experiences");
    bool galleryActive = isCurrent("Pages", "Gallery");
    bool contactActive = isCurrent("Pages", "Contact");
    bool adminActive = navController.StartsWith("Admin", StringComparison.OrdinalIgnoreCase);
    bool accountActive = isCurrent("Bookings", "") || isCurrent("Payments", "") || isCurrent("Reviews", "MyReviews");
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Fernwood Heritage Retreat</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-heritage sticky-top">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">F</span> Fernwood <span class="brand-sub">Heritage Retreat</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(homeActive ? "active" : "")" asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(hotelActive ? "active" : "")" href="#"
                               id="hotelDropdown" role="button" data-bs-toggle="dropdown"
                               aria-expanded="false">Hotel</a>
                            <ul class="dropdown-menu" aria-labelledby="hotelDropdown">
                                <li><a class="dropdown-item @(isCurrent("Pages", "About") ? "active" : "")"
                                           asp-controller="Pages" asp-action="About">Overview</a></li>
                                    <li><a class="dropdown-item @(isCurrent("Rooms", "Index") ? "active" : "")"
                                               asp-controller="Rooms" asp-action="Index">Rooms &amp; Suites</a></li>
                                        <li><a class="dropdown-item" asp-controller="Rooms" asp-action="Index">Amenities</a>
                                        </li>
                                        <li><a class="dropdown-item @(isCurrent("Reviews", "Index") ? "active" : "")"
                                                   asp-controller="Reviews" asp-action="Index">Guest Reviews</a></li>
                                            <li><a class="dropdown-item" asp-controller="Pages" asp-action="About">Our Story</a>
                                            </li>
                                            <li><a class="dropdown-item @(isCurrent("Pages", "Faq") ? "active" : "")"
                                                       asp-controller="Pages" asp-action="Faq">FAQs</a></li>
                                            </ul>
                                        </li>
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle @(diningActive ? "active" : "")" href="#"
                                               id="diningDropdown" role="button" data-bs-toggle="dropdown"
                                               aria-expanded="false">Dining</a>
                                            <ul class="dropdown-menu" aria-labelledby="diningDropdown">
                                                <li><a class="dropdown-item @(diningActive ? "active" : "")" asp-controller="Pages"
                                                           asp-action="Dining">Dining at Fernwood</a></li>
                                                </ul>
                                            </li>
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle @(experiencesActive ? "active" : "")" href="#"
                                                   id="experiencesDropdown" role="button" data-bs-toggle="dropdown"
                                                   aria-expanded="false">Experiences</a>
                                                <ul class="dropdown-menu" aria-labelledby="experiencesDropdown">
                                                    <li><a class="dropdown-item @(experiencesActive ? "active" : "")" asp-controller="Pages"
                                                               asp-action="Experiences">Our Experiences</a></li>
                                                    </ul>
                                                </li>
                                                <li class="nav-item">
                                                    <a class="nav-link @(galleryActive ? "active" : "")" asp-controller="Pages"
                                                       asp-action="Gallery">Gallery</a>
                                                </li>
                                                <li class="nav-item">
                                                    <a class="nav-link @(contactActive ? "active" : "")" asp-controller="Pages"
                                                       asp-action="Contact">Contact</a>
                                                </li>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <li class="nav-item dropdown">
                                                        <a class="nav-link dropdown-toggle @(adminActive ? "active" : "")" href="#"
                                                           id="adminDropdown" role="button" data-bs-toggle="dropdown"
                                                           aria-expanded="false">Admin</a>
                                                        <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                                            <li><a class="dropdown-item @(isCurrent("Admin", "Dashboard") ? "active" : "")"
                                                                       asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                                                <li><a class="dropdown-item @(isCurrent("Admin", "Bookings") ? "active" : "")"
                                                                           asp-controller="Admin" asp-action="Bookings">Bookings</a></li>
                                                                    <li><a class="dropdown-item @(isCurrent("Admin", "Customers") ? "active" : "")"
                                                                               asp-controller="Admin" asp-action="Customers">Customers</a></li>
                                                                        <li><a class="dropdown-item @(isCurrent("Admin", "Payments") ? "active" : "")"
                                                                                   asp-controller="Admin" asp-action="Payments">Payments</a></li>
                                                                            <li>
                                                                                <hr class="dropdown-divider" />
                                                                            </li>
                                                                            <li><a class="dropdown-item @(isCurrent("AdminRoomTypes", "") ? "active" : "")"
                                                                                       asp-controller="AdminRoomTypes" asp-action="Index">Room Types</a></li>
                                                                                <li><a class="dropdown-item @(isCurrent("AdminRooms", "") ? "active" : "")"
                                                                                           asp-controller="AdminRooms" asp-action="Index">Rooms</a></li>
                                                                                    <li><a class="dropdown-item @(isCurrent("AdminReviews", "") ? "active" : "")"
                                                                                               asp-controller="AdminReviews" asp-action="Index">Reviews</a></li>
                                                                                        <li><a class="dropdown-item @(isCurrent("AdminEnquiries", "") ? "active" : "")"
                                                                                                   asp-controller="AdminEnquiries" asp-action="Index">Enquiries</a></li>
                                                                                        </ul>
                                                                                    </li>
                                                                                }
                                                                            </ul>
                                                                            <ul class="navbar-nav ms-auto align-items-lg-center">
                                                                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                                                                {
                                                                                    <li class="nav-item">
                                                                                        <a class="nav-link @(isCurrent("Bookings", "") ? "active" : "")" asp-controller="Bookings"
                                                                                           asp-action="MyBookings">My Bookings</a>
                                                                                    </li>
                                                                                    <li class="nav-item dropdown">
                                                                                        <a class="nav-link dropdown-toggle @(accountActive ? "active" : "")" href="#"
                                                                                           id="accountDropdown" role="button" data-bs-toggle="dropdown"
                                                                                           aria-expanded="false">Hello, @User.Identity.Name</a>
                                                                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                                                                                            <li><a class="dropdown-item @(isCurrent("Bookings", "") ? "active" : "")"
                                                                                                       asp-controller="Bookings" asp-action="MyBookings">My Bookings</a></li>
                                                                                                <li><a class="dropdown-item @(isCurrent("Payments", "") ? "active" : "")"
                                                                                                           asp-controller="Payments" asp-action="History">My Payments</a></li>
                                                                                                    <li><a class="dropdown-item @(isCurrent("Reviews", "MyReviews") ? "active" : "")"
                                                                                                               asp-controller="Reviews" asp-action="MyReviews">My Reviews</a></li>
                                                                                                        <li>
                                                                                                            <hr class="dropdown-divider" />
                                                                                                        </li>
                                                                                                        <li>
                                                                                                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                                                                                                <button type="submit" class="dropdown-item">Logout</button>
                                                                                                            </form>
                                                                                                        </li>
                                                                                                    </ul>
                                                                                                </li>
                                                                                            }
                        else
                                                                                            {
                                                                                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                                                                                                </li>
                                                                                                <li class="nav-item"><a class="nav-link" asp-controller="Account"
                                                                                                                            asp-action="Register">Register</a></li>
                                                                                                }
                                                                                                <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                                                                                                    <a class="btn btn-book" asp-controller="Rooms" asp-action="Search">Book Now</a>
                                                                                                </li>
                                                                                            </ul>
                                                                                        </div>
                                                                                    </div>
                                                                                </nav>
                                                                            </header>

                                                                            <main role="main">
                                                                                @RenderBody()
                                                                            </main>

                                                                            <footer class="footer-heritage pt-5 pb-3 mt-5">
                                                                                <div class="container">
                                                                                    <div class="row">
                                                                                        <div class="col-md-4 mb-4">
                                                                                            <h5 class="footer-brand">Fernwood Heritage Retreat</h5>
                                                                                            <p class="mb-0">A quiet heritage stay above the valley. Old stone walls, wooden ceilings, valley
                                                                                                views, homely food and bonfire evenings.</p>
                                                                                            </div>
                                                                                            <div class="col-md-4 mb-4">
                                                                                                <h6>Quick Links</h6>
                                                                                                <div class="footer-links">
                                                                                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                                                                                    <a asp-controller="Rooms" asp-action="Index">Rooms</a>
                                                                                                    <a asp-controller="Pages" asp-action="Dining">Dining</a>
                                                                                                    <a asp-controller="Pages" asp-action="Experiences">Experiences</a>
                                                                                                    <a asp-controller="Pages" asp-action="Gallery">Gallery</a>
                                                                                                    <a asp-controller="Pages" asp-action="About">About</a>
                                                                                                    <a asp-controller="Reviews" asp-action="Index">Reviews</a>
                                                                                                    <a asp-controller="Pages" asp-action="Contact">Contact</a>
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-md-4 mb-4">
                                                                                                <h6>Contact</h6>
                                                                                                <p class="mb-1">Fernwood Estate, Jharipani Road, Mussoorie Hills, Mussoorie, Uttarakhand</p>
                                                                                                <p class="mb-1">Phone: +91 98765 43210</p>
                                                                                                <p class="mb-1">Email: stay@fernwoodheritage.in</p>
                                                                                            </div>
                                                                                        </div>
                                                                                        <hr />
                                                                                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                                                                                            <p class="mb-1 mb-md-0">&copy; 2026 Fernwood Heritage Retreat. All rights reserved.</p>
                                                                                            <a class="text-decoration-none" asp-controller="Home" asp-action="Privacy"
                                                                                               style="color: #D8CFC0;">Privacy Policy</a>
                                                                                        </div>
                                                                                    </div>
                                                                                </footer>

                                                                                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                                                                                <script src="~/js/site.js" asp-append-version="true"></script>
                                                                                @await RenderSectionAsync("Scripts", required: false)
                                                                            </body>

                                                                        </html>
