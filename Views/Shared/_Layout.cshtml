<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fernwood Heritage Retreat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-cream fixed-top shadow-sm">
            <div class="container">
                <a class="navbar-brand brand" href="#home">
                    <span class="brand-mark">F</span> Fernwood <span class="brand-sub">Heritage Retreat</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="#rooms">Rooms</a></li>
                        <li class="nav-item"><a class="nav-link" href="#dining">Dining</a></li>
                        <li class="nav-item"><a class="nav-link" href="#experiences">Experiences</a></li>
                        <li class="nav-item"><a class="nav-link" href="#gallery">Gallery</a></li>
                        <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="#faq">FAQ</a></li>
                        <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0"><a class="btn btn-heritage" href="#booking">Book
                            Now</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <main role="main">
            @RenderBody()
        </main>
        <footer class="footer-heritage">
            <div class="container py-5">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <h5 class="footer-brand">Fernwood Heritage Retreat</h5>
                        <p class="text-muted">A quiet heritage stay above the valley. Old stone walls, wooden ceilings,
                            valley views, homely food and bonfire evenings.</p>
                            <p class="text-muted small">Check-in 2:00 PM &nbsp;•&nbsp; Check-out 11:00 AM</p>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h6>Explore</h6>
                            <ul class="list-unstyled footer-links">
                                <li><a href="#rooms">Rooms &amp; Suites</a></li>
                                <li><a href="#dining">Dining</a></li>
                                <li><a href="#experiences">Experiences</a></li>
                                <li><a href="#gallery">Gallery</a></li>
                                <li><a href="#about">Our Story</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h6>Contact</h6>
                            <p class="text-muted mb-1">Fernwood Estate, Jharipani Road, Mussoorie Hills, Uttarakhand</p>
                            <p class="text-muted mb-1">Phone: +91 98765 43210</p>
                            <p class="text-muted mb-1">Email: stay@fernwoodheritage.in</p>
                            <p class="text-muted small">Hotel name, phone and address are editable in Admin - Hotel Profile
                                Settings. This is a single-hotel website.</p>
                            </div>
                        </div>
                        <hr />
                        <p class="text-center text-muted small mb-0">&copy; 2026 Fernwood Heritage Retreat - Single Hotel
                            Reservation and Booking Management System. Original branding and content for college capstone
                            demonstration.</p>
                        </div>
                    </footer>
                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                    <script src="~/js/site.js" asp-append-version="true"></script>
                    @await RenderSectionAsync("Scripts", required: false)
                </body>

            </html>
