<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Fernwood Heritage Retreat</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">F</span> Fernwood <span class="brand-sub">Heritage Retreat</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="/#home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#rooms">Rooms</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#dining">Dining</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#experiences">Experiences</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#gallery">Gallery</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0"><a class="btn btn-heritage" href="/#booking">Book
                            Now</a></li>
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                                    <span class="nav-link">Hello, @User.Identity.Name</span>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item mt-2 mt-lg-0"><a class="nav-link" asp-controller="AdminRoomTypes"
                                                                             asp-action="Index">Room Types</a></li>
                                        <li class="nav-item mt-2 mt-lg-0"><a class="nav-link" asp-controller="AdminRooms"
                                                                                 asp-action="Index">Rooms</a></li>
                                        }
                                        <li class="nav-item mt-2 mt-lg-0">
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-link nav-link">Logout</button>
                                            </form>
                                        </li>
                                    }
                        else
                                    {
                                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0"><a class="nav-link" asp-controller="Account"
                                                                                         asp-action="Login">Login</a></li>
                                            <li class="nav-item mt-2 mt-lg-0"><a class="nav-link" asp-controller="Account"
                                                                                     asp-action="Register">Register</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </nav>
                        </header>

                        <main role="main">
                            @RenderBody()
                        </main>

                        <footer class="footer-heritage pt-5 pb-3 mt-5">
                            <div class="container">
                                <div class="row">
                                    <div class="col-md-4 mb-4">
                                        <h5 class="footer-brand">Fernwood Heritage Retreat</h5>
                                        <p class="mb-0">A quiet heritage stay above the valley. Old stone walls, wooden ceilings, valley
                                            views, homely food and bonfire evenings.</p>
                                        </div>
                                        <div class="col-md-4 mb-4">
                                            <h6>Quick Links</h6>
                                            <div class="footer-links">
                                                <a href="/#home">Home</a>
                                                <a href="/#rooms">Rooms</a>
                                                <a href="/#dining">Dining</a>
                                                <a href="/#experiences">Experiences</a>
                                                <a href="/#gallery">Gallery</a>
                                                <a href="/#about">About</a>
                                                <a href="/#faq">FAQ</a>
                                                <a href="/#contact">Contact</a>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-4">
                                            <h6>Contact</h6>
                                            <p class="mb-1">Fernwood Estate, Jharipani Road, Mussoorie Hills, Mussoorie, Uttarakhand</p>
                                            <p class="mb-1">Phone: +91 98765 43210</p>
                                            <p class="mb-1">Email: stay@fernwoodheritage.in</p>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                                        <p class="mb-1 mb-md-0">&copy; 2026 Fernwood Heritage Retreat. All rights reserved.</p>
                                        <a class="text-decoration-none" asp-controller="Home" asp-action="Privacy"
                                           style="color: #D8CFC0;">Privacy Policy</a>
                                    </div>
                                </div>
                            </footer>

                            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                            <script src="~/js/site.js" asp-append-version="true"></script>
                            @await RenderSectionAsync("Scripts", required: false)
                        </body>

                    </html>
