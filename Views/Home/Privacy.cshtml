@{
    ViewData["Title"] = "Privacy Policy - Fernwood Heritage Retreat";
}

<section class="section">
    <div class="container">
        <p class="section-eyebrow">Fernwood Heritage Retreat</p>
        <h1 class="section-title">Privacy Policy</h1>
        <p class="text-muted">Last updated: 20 November 2026</p>

        <h4 class="mt-4">What information we collect</h4>
        <p>When you register or make a booking, we collect your name, email address, phone number and booking details
            (dates, guests, room type). We do not store your card details on our servers — payments are processed by the
            payment gateway you choose at checkout.</p>

            <h4 class="mt-4">How we use your information</h4>
            <p>We use your details only to manage your booking, confirm it by email, contact you about your stay, and
                improve our service. We never sell your personal information to anyone.</p>

                <h4 class="mt-4">Cookies</h4>
                <p>This website uses a login cookie to keep you signed in while you browse. No advertising or tracking cookies
                    are used.</p>

                    <h4 class="mt-4">Your choices</h4>
                    <p>You can ask us at any time to correct or delete your account details by writing to us at the address below.
                        Deleting your account does not delete past booking records, which we keep for our own accounting.</p>

                        <h4 class="mt-4">Contact us</h4>
                        <p>
                            Fernwood Heritage Retreat<br />
                            Fernwood Estate, Jharipani Road, Mussoorie Hills, Mussoorie, Uttarakhand<br />
                            Phone: +91 98765 43210<br />
                            Email: stay@fernwoodheritage.in
                        </p>
                    </div>
                </section>
