@model IEnumerable<HotelBookingSystem.Models.Amenity>
@{
    ViewData["Title"] = "Amenities";
}
<div class="container py-5" style="margin-top: 70px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="font-family: 'Playfair Display', serif;">Amenities</h2>
        <a asp-action="Create" class="btn btn-heritage">Add Amenity</a>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Icon</th>
                <th>Description</th>
                <th>Used By</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Icon ?? "-")</td>
                    <td>@(item.Description ?? "-")</td>
                    <td>@item.RoomTypeAmenities.Count room type(s)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.AmenityId">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.AmenityId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
